# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : uniquement côté serveur (Vercel > Environment Variables). Ne jamais la publier.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Lecture automatique des bordereaux et factures photographiés (console.anthropic.com > API Keys).
# Uniquement dans Vercel > Environment Variables. Ne jamais la publier.
ANTHROPIC_API_KEY=sk-ant-...
